# Run PostgreSQL and Redis yourself. Only application configuration is included here.
PORT=4000
NODE_ENV=development
# Browser origins allowed to call this API: comma-separated, full origins (scheme + host + port), no wildcard.
# 5173 = Vite dev server, 8000 = web container. If the web app's address is missing here the browser blocks every
# request with a CORS error. Outside production, localhost/127.0.0.1 on 5173, 4173 and 8000 are also allowed automatically.
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgrespass@postgres:5432/orbit_chat
REDIS_URL=rediss://:redispass@redis:6379



# Generate a unique long random value (minimum 32 characters). Never commit the actual secret.
SESSION_SECRET=2ec833642d5b12cbdced5199fc112f7f07c0d0e2cf652c47e79e553a9361f13a
# Set to 1 only when behind a correctly configured trusted reverse proxy.
TRUST_PROXY=0
# Create/upgrade database tables automatically when the API starts. Set to 0 to run `npm run db:migrate` yourself.
AUTO_MIGRATE=1
# Session cookie Secure flag: auto (default, follows HTTPS), 1 (always) or 0 (never).
COOKIE_SECURE=auto


# ------------------------------------------ POSTGRESQL

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespass
POSTGRES_DB=orbit_chat

# --------------------------------------------
#                    ||||
# -------------------------------------------- PGADMIN DASHBOARD

PGADMIN_DEFAULT_EMAIL=example@gmail.com
PGADMIN_DEFAULT_PASSWORD=password
PGADMIN_LISTEN_PORT=8080

# --------------------------------------------- REDIS 
REDIS_USER=redis
REDIS_PASSWORD=redispass
RI_APP_HOST=127.0.0.1
RI_APP_PORT=8000
RI_LOG_LEVEL=info
RI_FILES_LOGGER=true 
RI_DATABASE_MANAGEMENT=true
RI_ACCEPT_TERMS_AND_CONDITIONS=true
# REDIS_CA_CERT_PATH=/run/redis-tls/ca.crt

REDIS_CA_CERT_PATH=./certs/ca.crt

RI_SERVER_TLS_KEY=yes 
