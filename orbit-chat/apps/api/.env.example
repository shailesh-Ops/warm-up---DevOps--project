# Run PostgreSQL and Redis yourself. Only application configuration is included here.
PORT=4000
NODE_ENV=development
# Browser origins allowed to call this API: comma-separated, full origins (scheme + host + port), no wildcard.
# 5173 = Vite dev server, 8000 = web container. If the web app's address is missing here the browser blocks every
# request with a CORS error. Outside production, localhost/127.0.0.1 on 5173, 4173 and 8000 are also allowed automatically.
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgrespass@postgres:5432/orbit_chat
# Use rediss:// (two s) when Redis TLS is enabled. The host must be the Docker service name (redis) or any name that is
# listed in the Redis certificate (see scripts/gen-certs.sh). Percent-encode special characters in the password.
REDIS_URL=rediss://:redispass@redis:6379

# Redis TLS: CA certificate used to verify the Redis server certificate (REDIS_TLS_CA_PATH is accepted as an alias).
#   Docker compose: mount ./certs/ca.crt at /certs/ca.crt   -> /certs/ca.crt
#   API run on your machine (from apps/api)                 -> ../../certs/ca.crt
REDIS_TLS_CA_CERT_PATH=/certs/ca.crt
# Verification stays on. false is refused when NODE_ENV=production.
REDIS_TLS_REJECT_UNAUTHORIZED=true
# Only when the URL host differs from a name in the certificate (e.g. REDIS_URL uses an IP address):
# REDIS_TLS_SERVERNAME=redis

# Optional mutual TLS (mTLS): set BOTH paths only if Redis runs with --tls-auth-clients yes.
# REDIS_TLS_CLIENT_CERT_PATH=/certs/client.crt
# REDIS_TLS_CLIENT_KEY_PATH=/certs/client.key

# ------------------------------------------ HTTPS FOR THE API (optional)
# Leave these unset to serve plain HTTP (right when a reverse proxy already terminates TLS; then set TRUST_PROXY=1).
# Setting both paths turns HTTPS on. Turn it on together with HTTPS for the web app: browsers can treat an http:// page
# calling an https:// API as a different site and then do not send the SameSite=Lax session cookie.
# HTTPS_KEY_PATH=/certs/api.key
# HTTPS_CERT_PATH=/certs/api.crt
# HTTPS_MIN_VERSION=TLSv1.2
# HTTPS_CA_PATH=
# HTTPS_PASSPHRASE=
# Optional plain-HTTP port that only redirects to PUBLIC_URL (needs HTTPS on):
# HTTP_REDIRECT_PORT=4080
# PUBLIC_URL=https://localhost:4000

# Generate a unique long random value (minimum 32 characters). Never commit the actual secret.
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
# Set to 1 only when behind a correctly configured trusted reverse proxy.
TRUST_PROXY=0
# Create/upgrade database tables automatically when the API starts. Set to 0 to run `npm run db:migrate` yourself.
AUTO_MIGRATE=1
# Session cookie Secure flag: auto (default, follows HTTPS), 1 (always) or 0 (never).
COOKIE_SECURE=auto


# ------------------------------------------ POSTGRESQL

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespass
POSTGRES_DB=orbit_chat

# --------------------------------------------
#                    ||||
# -------------------------------------------- PGADMIN DASHBOARD

PGADMIN_DEFAULT_EMAIL=example@gmail.com
PGADMIN_DEFAULT_PASSWORD=password
PGADMIN_LISTEN_PORT=8080

# --------------------------------------------- REDIS 
REDIS_USER=redis
REDIS_PASSWORD=redispass
RI_APP_HOST=127.0.0.1
RI_APP_PORT=8000
RI_LOG_LEVEL=info
RI_FILES_LOGGER=true 
RI_DATABASE_MANAGEMENT=true
RI_ACCEPT_TERMS_AND_CONDITIONS=true
# RedisInsight TLS settings are separate from the API Redis client TLS settings.
