# Run PostgreSQL and Redis yourself. Only application configuration is included here.
PORT=4000
NODE_ENV=development
# Browser origins allowed to call this API: comma-separated, full origins (scheme + host + port), no wildcard.
# 5173 = Vite dev server, 8000 = web container. If the web app's address is missing here the browser blocks every
# request with a CORS error. Outside production, localhost/127.0.0.1 on 5173, 4173 and 8000 are also allowed automatically.
WEB_ORIGIN=http://localhost:5173,http://localhost:8000
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/orbit_chat
REDIS_URL=redis://127.0.0.1:6379
# Generate a unique long random value (minimum 32 characters). Never commit the actual secret.
SESSION_SECRET=8f7e10ffed697e87ddddf566abd578a4854cce5c30e0e61fe082150212547a7e
# Set to 1 only when behind a correctly configured trusted reverse proxy.
TRUST_PROXY=0
# Create/upgrade database tables automatically when the API starts. Set to 0 to run `npm run db:migrate` yourself.
AUTO_MIGRATE=1
# Session cookie Secure flag: auto (default, follows HTTPS), 1 (always) or 0 (never).
COOKIE_SECURE=auto
