# Run PostgreSQL and Redis yourself. Only application configuration is included here.
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/orbit_chat
REDIS_URL=redis://127.0.0.1:6379
# Generate a unique long random value (minimum 32 characters). Never commit the actual secret.
SESSION_SECRET=8f7e10ffed697e87ddddf566abd578a4854cce5c30e0e61fe082150212547a7e
# Set to 1 only when behind a correctly configured trusted reverse proxy.
TRUST_PROXY=0
